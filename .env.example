# Clé APNs .p8 (accepte les vrais retours à la ligne ou "\n" littéraux sur une seule ligne)
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=REDACTED_TEAM_ID
APNS_BUNDLE_ID=com.ebookrequest.ios.full
APNS_PRODUCTION=true
PORT=3040

# Chemin vers le fichier listant les instances autorisées (voir instances.example.json)
INSTANCES_FILE=./instances.json

# Secret admin pour /admin/pending, /admin/approve/:id, /admin/reject/:id
# (Authorization: Bearer <ADMIN_SECRET>). Sans lui, ces routes renvoient 503.
ADMIN_SECRET=

# Optionnel : URL webhook (ntfy.sh, Discord/Slack) notifiée à chaque nouvelle
# demande via /register-request. Format envoyé : { "text": "..." }. Si vide,
# seul un log console est émis.
NOTIFY_WEBHOOK_URL=
